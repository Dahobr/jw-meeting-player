{
  "name": "jw-meeting-player",
  "version": "1.3.0",
  "description": "JW Meeting Player",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "build": "electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.jw.meeting-player",
    "icon": "jwmp-icon.png",
    "win": {
      "target": "portable"
    },
    "extraResources": [
      {
        "from": "dist/bin/",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "marked": "^18.0.3",
    "music-metadata": "^11.12.3",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-mcp-server": "^1.5.0"
  }
}
