{
  "name": "jw-meeting-player",
  "version": "1.7.0",
  "description": "JW Meeting Player",
  "main": "main.js",
  "scripts": {
    "start": "electron main.js",
    "build": "electron-builder --win",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.jw.meeting-player",
    "icon": "jwmp-icon.png",
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "${name}-Setup-${version}.${ext}"
    },
    "extraResources": [
      {
        "from": "dist/bin/",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "scripts/ZoomControlManager/ZoomControlManager.exe",
        "to": "bin/ZoomControlManager.exe"
      },
      {
        "from": "scripts/ZoomSettingsOpener/ZoomSettingsOpener.exe",
        "to": "bin/ZoomSettingsOpener.exe"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Dahobr",
      "repo": "jw-meeting-player"
    }
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "adm-zip": "^0.5.17",
    "electron-updater": "^6.8.3",
    "marked": "^18.0.3",
    "music-metadata": "^11.12.3",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "electron": "^41.1.1",
    "electron-builder": "^26.8.1",
    "electron-mcp-server": "^1.5.0",
    "jest": "^30.4.2"
  }
}
